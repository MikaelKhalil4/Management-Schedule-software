trigger:
  - main

pool:
  vmImage: ubuntu-latest

jobs:
- job: MergeMainIntoBranches
  displayName: 'Merge Main into Custom Branches'
  steps:
  - checkout: self
    persistCredentials: true

  - script: |
      git config --global user.email "you@example.com"
      git config --global user.name "Your Name"
      git checkout main
      git pull origin main
      # Merging main into global
      git checkout -b global origin/global
      git merge main --no-ff -m "Merging changes from main into global"
      git push origin global
      # Merging main into elk
      git checkout -b elk origin/elk
      git merge main --no-ff -m "Merging changes from main into elk"
      git push origin elk
      # Merging main into soft
      git checkout -b soft origin/soft
      git merge main --no-ff -m "Merging changes from main into soft"
      git push origin soft
    displayName: 'Fetch Main and Merge into Branches'
